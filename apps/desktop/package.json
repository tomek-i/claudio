{
  "name": "dj-claude-desktop",
  "version": "0.9.0",
  "description": "Claudio, the desktop suite: DJ Claude, Claude-808, MiniClaude, Claudebase and Claudel, each in a window on the same server and page as in a browser.",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --projectDir ../.. --config apps/desktop/electron-builder.config.cjs --publish never",
    "dist:mac": "electron-builder --projectDir ../.. --config apps/desktop/electron-builder.config.cjs --publish never --mac"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
