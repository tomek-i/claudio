{
  "name": "dj-claude",
  "version": "0.5.0",
  "description": "A Claude-powered DJ: browser decks + a CLI that Claude drives through skills.",
  "private": true,
  "author": {
    "name": "tomek-i",
    "email": "tomek.iwainski@gmail.com",
    "url": "https://github.com/tomek-i"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomek-i/dj-claude.git"
  },
  "homepage": "https://github.com/tomek-i/dj-claude#readme",
  "bugs": {
    "url": "https://github.com/tomek-i/dj-claude/issues"
  },
  "keywords": [
    "dj",
    "web-audio",
    "claude-code",
    "beatmatching",
    "cli"
  ],
  "type": "module",
  "bin": {
    "dj": "./dj.mjs"
  },
  "scripts": {
    "start": "node apps/server/server.mjs",
    "desktop": "pnpm --filter dj-claude-desktop start",
    "dist": "pnpm --filter dj-claude-desktop dist",
    "drums": "node apps/drums/server.mjs",
    "synth": "node apps/synth/server.mjs",
    "daw": "node apps/daw/server.mjs",
    "test": "node --test test/*.test.mjs test/server-*.mjs apps/*/test/*.test.mjs",
    "scan": "node dj.mjs scan",
    "setup": "node dj.mjs doctor --fix",
    "banner": "node dj.mjs banner"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912"
}
